# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.

# --- Núcleo ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambia-esto-por-una-cadena-larga-y-secreta
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# --- Base de datos ---
# Local: deja DATABASE_URL vacío para usar SQLite.
# Prod (Neon/Vercel/Supabase): postgres://usuario:password@host:5432/dbname
DATABASE_URL=
DB_SSLMODE=require

# --- Correo (recuperación de contraseña / confirmaciones) ---
# EMAIL_USE_SMTP=0 usa la consola (desarrollo). =1 activa SMTP real.
EMAIL_USE_SMTP=0
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Evaluaciones Arena <no-reply@arena-analytics.com>

# --- Seed del superusuario (manage.py seed_superuser / seed_all) ---
SEED_SU_EMAIL=admin@arena-analytics.com
SEED_SU_PASSWORD=cambia-esta-contrasena
SEED_SU_NAME=Administrador Arena
